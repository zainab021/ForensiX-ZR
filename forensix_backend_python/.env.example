# CHANGE SECRET_KEY in production — use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-64-CHAR-RANDOM-SECRET

# ─── PostgreSQL credentials (must match root-level .env values used by docker-compose.yml) ───
# These are read by the backend container at runtime.
# POSTGRES_PASSWORD must also be set in the root-level .env for docker-compose.
POSTGRES_USER=forensix
POSTGRES_PASSWORD=CHANGE-THIS-TO-A-STRONG-RANDOM-PASSWORD
POSTGRES_DB=forensix_db

# Local dev (SQLite) — default if unset
# DATABASE_URL=sqlite:///./forensix.db
# Production (PostgreSQL) — recommended for real deployments
DATABASE_URL=postgresql://forensix:forensix@localhost:5432/forensix_db

# JWT access-token lifetime in minutes.
# 30 minutes is a reasonable default; increase only if your UX requires it.
# 1440 (24h) is too long for production — compromise if a session is stolen.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated approved officer/admin codes.
# REQUIRED — the application will NOT start if this variable is absent.
# Replace these example codes with your real internal codes before deployment.
VALID_OFFICER_CODES=ZR-ADMIN-001,ZR-OFC-101,ZR-OFC-102,ZR-OFC-103

# Comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Comma-separated allowed Host headers.
# Development: "*" allows any host (convenient for local dev / Docker).
# Production: MUST be set to your real domain(s), e.g. ALLOWED_HOSTS=forensix.example.com
# Leaving "*" in production exposes the backend to Host header injection attacks.
ALLOWED_HOSTS=*

# Auto-create demo admin/officer/citizen accounts with known weak passwords on startup.
# SEC-03: Default is "false" in application code — must be explicitly set to "true" for dev.
# MUST be absent or "false" in production.
SEED_DEMO_USERS=false

# SMTP settings for sending password-reset OTP codes (Gmail SMTP).
# 1. Enable 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Create an App Password: myaccount.google.com/apppasswords
# 3. Use the Gmail address as SMTP_USER and the 16-character App Password as SMTP_PASSWORD
#    (not your normal Gmail login password).
# If left unset, OTP emails are skipped and logged to the server console instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ForensiX ZR Unit

# Optional: Groq API key (free, get one at https://console.groq.com/keys)
# Powers the AI assistant chatbot with full Roman Urdu/Urdu/English understanding.
# If left empty, the chatbot falls back to the rule-based FAQ responses.
GROQ_API_KEY=