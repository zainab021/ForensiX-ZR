# CHANGE SECRET_KEY in production — use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-64-CHAR-RANDOM-SECRET

# Local dev (SQLite) — default if unset
# DATABASE_URL=sqlite:///./forensix.db
# Production (PostgreSQL) — recommended for real deployments
DATABASE_URL=postgresql://forensix:forensix@localhost:5432/forensix_db

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated approved officer/admin codes
VALID_OFFICER_CODES=ZR-ADMIN-001,ZR-OFC-101,ZR-OFC-102,ZR-OFC-103

# Comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Comma-separated allowed Host headers ("*" allows any — fine for local dev, set to your real domain(s) in production)
ALLOWED_HOSTS=*

# Auto-create demo admin/officer/citizen accounts with known weak passwords on startup.
# MUST be "false" in production.
SEED_DEMO_USERS=true