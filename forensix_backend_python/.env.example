# CHANGE SECRET_KEY in production — use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-64-CHAR-RANDOM-SECRET

# Local dev (SQLite)
DATABASE_URL=sqlite:///./forensix.db
# Production (PostgreSQL): postgresql://user:pass@host:5432/forensix_db

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated approved officer/admin codes
VALID_OFFICER_CODES=ZR-ADMIN-001,ZR-OFC-101,ZR-OFC-102,ZR-OFC-103