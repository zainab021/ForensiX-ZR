# Root-level .env — Docker Compose variables
# Copy this file to .env in the same directory as docker-compose.yml and fill in real values.
# This file is read automatically by Docker Compose for ${VARIABLE} substitution.
# NEVER commit the actual .env to version control.

# ─── PostgreSQL credentials (used by both the db service and backend DATABASE_URL) ───
# REQUIRED — no default. Docker Compose will refuse to start if POSTGRES_PASSWORD is missing.
POSTGRES_USER=forensix
POSTGRES_PASSWORD=CHANGE-THIS-TO-A-STRONG-RANDOM-PASSWORD
POSTGRES_DB=forensix_db
